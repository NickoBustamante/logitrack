  class="item-selector-container content-visibility-selector" bb-cache-compilation="content-visibility-selector">
  <!-- To allow instructors to see visibility status in a completed course -->
  <div
    ng-if="!contentVisibilitySelector.isEditable() && contentVisibilitySelector.entitledToViewDesigner && content.isVisibleToStudents()"
    class="visibility-message visibility-label">
    <bb-svg-icon size="{{::contentVisibilitySelector.getIconSize()}}" icon="visible" class="visibility-icon">
    </bb-svg-icon>
    <span class="js-visibility js-visible-option vert-centered-label-text" bb-translate course-org-token-resolver>
      components.directives.content-visibility.visible
    </span>
  </div>
  <!-- To allow instructors to see visibility status in a completed course -->
  <div
    ng-if="!contentVisibilitySelector.isEditable() && contentVisibilitySelector.entitledToViewDesigner && content.isHiddenFromStudents()"
    class="visibility-message visibility-label">
    <bb-svg-icon size="{{::contentVisibilitySelector.getIconSize()}}" icon="invisible" class="visibility-icon">
    </bb-svg-icon>
    <span bb-translate course-org-token-resolver>components.directives.content-visibility.hidden</span>
  </div>
  <!-- To allow instructors to see visibility status in a completed course -->
  <div
    ng-if="!contentVisibilitySelector.isEditable() && contentVisibilitySelector.entitledToViewDesigner && content.isConditionalRelease()"
    class="visibility-message visibility-label">
    <bb-svg-icon size="{{::contentVisibilitySelector.getIconSize()}}" icon="lock" class="visibility-icon"></bb-svg-icon>
    <span class="js-visibility js-restricted-option js-conditional-release-option"
      bb-translate>components.directives.content-visibility.conditional-availability</span>
  </div>
  <button name="visibility-content" ng-model="content.visible" ng-disabled="contentVisibilitySelector.isDisabled" ng-show="contentVisibilitySelector.isEditable()"
    bb-prevent-click-if="!contentVisibilitySelector.isVisibilitySelectorEnabled()" type="button" class="button dropdown"
    aria-controls="item-visibility-selector_{{::contentVisibilitySelector.selectorId}}"
    ng-click="contentVisibilitySelector.checkForCourseLinks()"
    data-dropdown="item-visibility-selector_{{::contentVisibilitySelector.selectorId}}" aria-expanded="false"
    analytics-id="course.content.visibility.button">
    <div class="visibility-label" ng-if="contentVisibilitySelector.isVisibleToStudents()">
      <bb-svg-icon size="{{::contentVisibilitySelector.getIconSize()}}" icon="visible" class="visibility-icon">
      </bb-svg-icon>
      <span class="js-visibility js-visible-option vert-centered-label-text" bb-translate course-org-token-resolver>
        components.directives.content-visibility.visible
      </span>
    </div>
    <div class="visibility-label" ng-if="contentVisibilitySelector.isHiddenFromStudents()">
      <bb-svg-icon size="{{::contentVisibilitySelector.getIconSize()}}" icon="invisible" class="visibility-icon">
      </bb-svg-icon>
      <span class="js-visibility js-hidden-option vert-centered-label-text" bb-translate course-org-token-resolver>
        components.directives.content-visibility.hidden
      </span>
    </div>
    <div class="visibility-label" ng-if="contentVisibilitySelector.isConditionalRelease()">
      <bb-svg-icon size="{{::contentVisibilitySelector.getIconSize()}}" icon="lock" class="visibility-icon">
      </bb-svg-icon>
      <span class="js-visibility js-restricted-option vert-centered-label-text"
        bb-translate>components.directives.content-visibility.conditional-availability</span>
    </div>
  </button>

  <ul ng-if="contentVisibilitySelector.isEditable()"
    id="item-visibility-selector_{{::contentVisibilitySelector.selectorId}}"
    class="f-dropdown item-visibility-selector selection-full-width" data-dropdown-content aria-hidden="true">
    <li
      ng-class="{'item-selected': contentVisibilitySelector.isVisibleToStudents(), 'restricted-visibility-option': contentVisibilitySelector.isVisibleOptionRestricted}"
      ng-if="contentVisibilitySelector.showVisibleHiddenMenuOptions()">
      <a href="javascript:void(0);" ng-click="contentVisibilitySelector.selectVisible()"
        ng-attr-tabindex="{{contentVisibilitySelector.getOptionTabIndex(contentVisibilitySelector.isVisibleOptionRestricted)}}"
        ng-attr-aria-disabled="{{contentVisibilitySelector.getOptionAriaDisabled(contentVisibilitySelector.isVisibleOptionRestricted)}}"
        ng-attr-aria-describedby="{{contentVisibilitySelector.getOptionAriaDescribedBy(contentVisibilitySelector.isVisibleOptionRestricted)}}"
        class="visible-option visibility-label" analytics-id="components.directives.content-visibility.visible.link">
        <bb-svg-icon size="{{::contentVisibilitySelector.getIconSize()}}" icon="visible"></bb-svg-icon>
        <span bb-translate course-org-token-resolver>components.directives.content-visibility.visible</span>
      </a>
    </li>
    <li ng-class="{'item-selected': contentVisibilitySelector.isHiddenFromStudents()}"
      ng-if="contentVisibilitySelector.showVisibleHiddenMenuOptions()">
      <a href="javascript:void(0);" ng-click="contentVisibilitySelector.selectHidden()"
        class="hidden-option visibility-label" analytics-id="components.directives.content-visibility.hidden.link">
        <bb-svg-icon size="{{::contentVisibilitySelector.getIconSize()}}" icon="invisible"></bb-svg-icon>
        <span bb-translate course-org-token-resolver>components.directives.content-visibility.hidden</span>
      </a>
    </li>
    <li ng-if="contentVisibilitySelector.showConditionalReleaseMenuOption()"
      ng-class="{'item-selected': contentVisibilitySelector.isConditionalRelease(), 'restricted-visibility-option': contentVisibilitySelector.isConditionalReleaseOptionRestricted}">
      <a href="javascript:void(0);" ng-click="contentVisibilitySelector.selectConditionalRelease()"
        ng-attr-tabindex="{{contentVisibilitySelector.getOptionTabIndex(contentVisibilitySelector.isConditionalReleaseOptionRestricted)}}"
        ng-attr-aria-disabled="{{contentVisibilitySelector.getOptionAriaDisabled(contentVisibilitySelector.isConditionalReleaseOptionRestricted)}}"
        ng-attr-aria-describedby="{{contentVisibilitySelector.getOptionAriaDescribedBy(contentVisibilitySelector.isConditionalReleaseOptionRestricted)}}"
        class="restricted-option visibility-label conditional-release-restricted-option"
        analytics-id="components.directives.content-visibility.conditional-availability.link">
        <bb-svg-icon size="{{::contentVisibilitySelector.getIconSize()}}" icon="lock"></bb-svg-icon>
        <span bb-translate>components.directives.content-visibility.conditional-availability</span>
      </a>
    </li>
    <course-link-visibility-warning-banner
      ng-if="contentVisibilitySelector.shouldShowCourseLinkWarningBanner"></course-link-visibility-warning-banner>
    <content-visibility-warning-banner ng-if="contentVisibilitySelector.shouldShowContentVisibilityWarningBanner"
      has-course-links="contentVisibilitySelector.hasCourseLinks"
      is-test-or-survey-without-answerable-questions="contentVisibilitySelector.hasVisibilityRestrictionNoQuestions"
      question-warning-message="contentVisibilitySelector.questionWarningMessage">
    </content-visibility-warning-banner>
  </ul>
  <span ng-if="contentVisibilitySelector.shouldShowContentVisibilityWarningBanner"
    id="{{::contentVisibilitySelector.bannerInfoSrOnlyId}}" class="sr-only"
    bb-translate translate-values="{assessmentQuestionWarningMessage: contentVisibilitySelector.questionWarningMessage}">components.directives.content-visibility.testOrSurveyHasNoAnswerableQuestionsWarning</span>
</div>
