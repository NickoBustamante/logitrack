    <div class="gradebook-toolbar group-filters">
      <div class="toggle-group-filters-enabled">
        <bb-gradebook-list-view-tabs
          on-tab-changed="courseGradesGrader.changeGradebookViewType"
          selected-tab="courseGradesGrader.view"
          can-view-grid-tab="true"
          can-view-mastery-tab="courseGradesGrader.canViewMasteryTab"
          ></bb-gradebook-list-view-tabs>
      </div>
      <div class="gradebook-options">
        <non-visible-items-count ng-if="courseGradesGrader.isGradableItemsListView || courseGradesGrader.isGridView" display-mode="withoutTotal" hide-non-visible-count-if-zero="true"></non-visible-items-count>
        <div class="grade-grid-search-box group-filters" ng-if="courseGradesGrader.isGridView && !courseGradesGrader.isMediumBreakpoint">
          <bb-typeahead-search-box id="student-search-box"
            item-selected="courseGradesGrader.itemSelected(item)"
            type-ahead-search="courseGradesGrader.typeAheadSearch(searchText)"
            clear-search="courseGradesGrader.clearSelection()"
            input-placeholder="components.directives.grade.search-box.placeholder"
            sr-empty-results="components.directives.grade.search-box.emptyResults"
            sr-results-found="components.directives.grade.search-box.resultsFound"
            sr-no-results-found="components.directives.grade.search-box.noResultsFound"
            sr-label="components.directives.grade.search-box.placeholder"
            clear-aria-label="components.directives.grade.search-box.clear"
            icon="search">
            <ng-switch on="item.type">
              <div ng-switch-when="user" class="element-card">
                <bb-user-avatar class="typeahead-user-avatar" user="::item.data.user"></bb-user-avatar>
                <div class="typeahead-student-name-id">
                  <bb-username class="typeahead-name ellipse" user="item.data.user"></bb-username>
                  <div class="typeahead-id ellipse">{{::item.data.user.userName}}</div>
                </div>
              </div>
              <div ng-switch-when="column" class="element-card">
                <div bb-content-item-icon content-column="item.data.getMetadata()" show-alert-icon="item.data.getMetadata().getNumMissingIfLate() > 0" class="element-image" ng-if="item.data.getMetadata()"></div>
                <div class="typehead-title column-title js-column-title ellipse">
                  <div class="ellipse grade-title">{{::item.data.getMetadata().columnName}}</div>
                  <div class="ellipse grade-type" bb-translate>components.directives.grade.search-box.columnName</div>
                </div>
              </div>
              <div ng-switch-when="category" class="element-card">
                <bb-ui-icon-large-document-multiple color="primary"></bb-ui-icon-large-document-multiple>
                <div class="typehead-title category-title js-category-title ellipse">
                  <div bb-translate class="ellipse grade-title" ng-if="::!item.data.getMetadata().gradebookCategory.isUserDefined">{{::item.data.getMetadata().gradebookCategory.localizableTitle.languageKey}}</div>
                  <div bb-translate class="ellipse grade-title" ng-if="::item.data.getMetadata().gradebookCategory.isUserDefined">{{::item.data.getMetadata().gradebookCategory.title.split('.')[0]}}</div>
                  <div bb-translate class="ellipse grade-title" ng-if="::!item.data.getMetadata().gradebookCategory">gradebook.gradableItemStatistics.itemInformation.noCategory</div>
                  <div class="ellipse grade-type" bb-translate>components.directives.grade.search-box.category</div>
                </div>
              </div>
              <div ng-switch-default="noResult" class="element-card">
                <div class="no-result" bb-translate>components.directives.grade.search-box.noResultsFound</div>
              </div>
            </ng-switch>
          </bb-typeahead-search-box>
        </div>
        <div ng-if="courseGradesGrader.isGridView && courseGradesGrader.showGradeListContainer() && !courseGradesGrader.isMediumBreakpoint">
          <a class="filter-panel-button super-clear button"
            bb-translate-attrs="{'aria-label': 'components.directives.grade.course-grades-grader.actions.openAdvancedFilters'}"
            bb-peek-sref="gradebook-grid-advanced-filters" analytics-id="components.directives.grade.search.filter.button">
            <bb-ui-icon-small-filter-options class="group-filters-icon"></bb-ui-icon-small-filter-options>
            <span bb-translate>components.directives.grade.course-grades-grader.actions.filter</span>
          </a>
        </div>
        <div ng-if="courseGradesGrader.userHasViewGradebookPermission && !courseGradesGrader.isMasteryGradebookView && !courseGradesGrader.isOverviewGradebookView">
          <a class="open-attempt-receipt-search button super-clear"
            bb-translate-attrs="{'aria-label': 'components.directives.grade.course-grades-grader.actions.attemptReceiptSearch', 'title':'components.directives.grade.course-grades-grader.actions.attemptReceiptSearch'}"
            bb-peek-sref="attempt-receipt-search"
            analytics-id="components.directives.grade.actions.openAttemptReceiptSearch.link">
            <bb-ui-icon-medium-content-view></bb-ui-icon-medium-content-view>
          </a>
        </div>
        <div ng-if="courseGradesGrader.canUploadGradebook && !courseGradesGrader.isMasteryGradebookView && !courseGradesGrader.isOverviewGradebookView">
          <a class="open-upload-settings button super-clear"
            bb-translate-attrs="{'aria-label': 'components.directives.grade.course-grades-grader.actions.upload', 'title': 'components.directives.grade.course-grades-grader.actions.upload'}"
            bb-peek-sref="grade-upload-setting"
            ng-if="!courseGradesGrader.course.isComplete()"
            analytics-id="components.directives.grade.actions.upload.link">
            <bb-ui-icon-small-upload></bb-ui-icon-small-upload>
          </a>
        </div>
        <div ng-if="courseGradesGrader.canDownloadGradebook && !courseGradesGrader.isMasteryGradebookView && !courseGradesGrader.isOverviewGradebookView">
          <a class="open-downLoad-settings button super-clear"
            bb-translate-attrs="{'aria-label': 'components.directives.grade.course-grades-grader.actions.download', 'title': 'components.directives.grade.course-grades-grader.actions.download'}"
            bb-peek-sref="grade-download-setting"
            analytics-id="components.directives.grade.actions.download.link">
            <bb-ui-icon-small-download></bb-ui-icon-small-download>
          </a>
        </div>
        <div ng-if="courseGradesGrader.userHasViewGradebookPermission" course-id="course.model.id">
          <a class="open-gradebook-settings button super-clear js-open-settings"
            bb-translate-attrs="{'aria-label': 'components.directives.grade.course-grades-grader.actions.openSettings', 'title': 'components.directives.grade.course-grades-grader.actions.openSettings'}"
            bb-peek-sref="grade-setting"
            analytics-id="components.directives.grade.actions.openSettings.link">
            <bb-ui-icon-medium-settings></bb-ui-icon-medium-settings>
          </a>
        </div>
        <bb-view-scale-button ng-if="courseGradesGrader.isMasteryGradebookView"></bb-view-scale-button>
      </div>
    </div>
    <bb-filter-chips
      ng-if="courseGradesGrader.isGridView && courseGradesGrader.hasUrlFilters"
      analytics-id="gradebook.grid.filters">
    </bb-filter-chips>
  </div>
  <div class ="row collapse course-grades-header-buttons-wrapper" ng-if="courseGradesGrader.isGridView && courseGradesGrader.isMediumBreakpoint && courseGrades.isNewGradebookGridView === false">
    <div class="gradebook-options grid-view">
      <div class="grade-grid-search-box group-filters">
        <bb-typeahead-search-box id="student-search-box"
          item-selected="courseGradesGrader.itemSelected(item)"
          type-ahead-search="courseGradesGrader.typeAheadSearch(searchText)"
          clear-search="courseGradesGrader.clearSelection()"
          input-placeholder="components.directives.grade.search-box.placeholder"
          sr-empty-results="components.directives.grade.search-box.emptyResults"
          sr-results-found="components.directives.grade.search-box.resultsFound"
          sr-no-results-found="components.directives.grade.search-box.noResultsFound"
          sr-label="components.directives.grade.search-box.placeholder"
          clear-aria-label="components.directives.grade.search-box.clear"
          icon="search">
          <ng-switch on="item.type">
            <div ng-switch-when="user" class="element-card">
              <bb-user-avatar class="typeahead-user-avatar" user="::item.data.user"></bb-user-avatar>
              <div class="typeahead-student-name-id">
                <bb-username class="typeahead-name ellipse" user="item.data.user"></bb-username>
                <div class="typeahead-id ellipse">{{::item.data.user.userName}}</div>
              </div>
            </div>
            <div ng-switch-when="column" class="element-card">
              <div bb-content-item-icon content-column="item.data.getMetadata()" show-alert-icon="item.data.getMetadata().getNumMissingIfLate() > 0" class="element-image" ng-if="item.data.getMetadata()"></div>
              <div class="typehead-title column-title ellipse">
                <div class="ellipse grade-title">{{::item.data.getMetadata().columnName}}</div>
                <div class="ellipse grade-type" bb-translate>components.directives.grade.search-box.columnName</div>
              </div>
            </div>
            <div ng-switch-when="category" class="element-card">
              <bb-ui-icon-large-document-multiple color="primary"></bb-ui-icon-large-document-multiple>
              <div class="typehead-title category-title ellipse">
                <div bb-translate class="ellipse grade-title" ng-if="::!item.data.getMetadata().gradebookCategory.isUserDefined">{{::item.data.getMetadata().gradebookCategory.localizableTitle.languageKey}}</div>
                <div bb-translate class="ellipse grade-title" ng-if="::item.data.getMetadata().gradebookCategory.isUserDefined">{{::item.data.getMetadata().gradebookCategory.title.split('.')[0]}}</div>
                <div bb-translate class="ellipse grade-title" ng-if="::!item.data.getMetadata().gradebookCategory">gradebook.gradableItemStatistics.itemInformation.noCategory</div>
                <div class="ellipse grade-type" bb-translate>components.directives.grade.search-box.category</div>
              </div>
            </div>
            <div ng-switch-default="noResult" class="element-card">
              <div class="no-result" bb-translate>components.directives.grade.search-box.noResultsFound</div>
            </div>
          </ng-switch>
        </bb-typeahead-search-box>
      </div>
      <div ng-if="courseGradesGrader.isGridView && courseGradesGrader.showGradeListContainer()">
        <a class="filter-panel-button super-clear button"
          bb-translate-attrs="{'aria-label': 'components.directives.grade.course-grades-grader.actions.openAdvancedFilters'}"
          bb-peek-sref="gradebook-grid-advanced-filters" analytics-id="components.directives.grade.search.filter.button">
          <bb-ui-icon-small-filter-options class="group-filters-icon"></bb-ui-icon-small-filter-options>
          <span bb-translate>components.directives.grade.course-grades-grader.actions.filter</span>
        </a>
      </div>
    </div>
  </div>
  <bb-gradebook-list-view-tabs
    ng-if="courseGradesGrader.isMobileView"
    on-tab-changed="courseGradesGrader.changeGradebookViewType"
    selected-tab="courseGradesGrader.view"
    can-view-grid-tab="false"
    can-view-mastery-tab="courseGradesGrader.canViewMasteryTab"
    can-view-overview-tab="courseGradesGrader.canViewOverviewTab"
    ></bb-gradebook-list-view-tabs>
  <div ng-if="(courseGradesGrader.isGridView || courseGradesGrader.isGradableItemsListView)" class="grid-view-container">
    <gradebook-grid-view ng-if="courseGrades.isNewGradebookGridView === true"
                         on-view-mode-change="courseGradesGrader.onViewModeChange"
                         current-view-mode="courseGradesGrader.view"
                         is-student-id-displayable="courseGradesGrader.isStudentIdDisplayable"
                         ng-class="{'grid-view': courseGradesGrader.isGridView}">
    </gradebook-grid-view>
    <!-- Empty state template: this section of the page will be displayed when there is no content, and will invite users to create content -->
    <div class="is-empty-page js-course-skip-link-target"
      ng-if="courseGradesGrader.columns.$resolved && courseGradesGrader.columns.length === 0 && !courseGradesGrader.hasUrlFilters && courseGradesGrader.view === 'list'">
      <div class="is-empty-wrapper">
        <div class="is-empty-explanation">
          <img src="./static/images/ftue/course-grades-instructor.svg" bb-translate-attrs="{alt: 'components.directives.grade.course-grades-grader.empty.addItems'}" />
          <h1 class="is-empty-heading" bb-translate>components.directives.grade.course-grades-grader.empty.header</h1>
          <p bb-translate>components.directives.grade.course-grades-grader.empty.description</p>
        </div>
        <div class="add-element">
          <ul role="menu" class="element-list-add-menu small-block-grid-1 medium-block-grid-3 large-block-grid-4">
            <li>
              <a role="menuitem" class="js-empty-add-item" bb-translate-attrs="{'aria-label': 'components.directives.grade.course-grades-grader.empty.addItem'}"
                bb-peek-sref="grade-item.create" analytics-id="components.directives.addItem.link">
                <div>
                  <bb-svg-icon size="small" icon="add"></bb-svg-icon>
                  <span bb-translate>components.directives.grade.course-grades-grader.empty.addItem</span>
                </div>
              </a>
            </li>
            <li ng-if="courseGradesGrader.textColumnIsAvailable">
              <a role="menuitem" bb-translate-attrs="{'aria-label': 'components.directives.grade.course-grades-grader.empty.addTextItem'}"
                bb-peek-sref="gradebook-item.text-column" analytics-id="components.directives.grade.addTextItem.link">
                <div>
                  <bb-svg-icon size="small" icon="add"></bb-svg-icon>
                  <span bb-translate>components.directives.grade.course-grades-grader.empty.addTextItem</span>
                </div>
              </a>
            </li>
            <li ng-if="courseGradesGrader.attendanceIsAvailable">
              <a role="menuitem" bb-translate-attrs="{'aria-label': 'components.directives.grade.course-grades-grader.empty.addAttendance'}"
                bb-peek-sref="attendance" analytics-id="components.directives.grade.addAttendance.link">
                <div>
                  <bb-svg-icon size="small" icon="add"></bb-svg-icon>
                  <span bb-translate>components.directives.grade.course-grades-grader.empty.addAttendance</span>
                </div>
              </a>
            </li>
          </ul>
        </div>
      </div>
    </div>
    <div class="grade-list-container"
      ng-if="courseGradesGrader.isGradableItemsListView && courseGradesGrader.showGradeListContainer()">
      <div class="spinner bb-secondary-color-2" ng-if="!courseGradesGrader.columns" aria-hidden="true"></div>
      <div bb-infinite-scroll infinite-scroll-tray-id="course-grades-grader" infinite-scroll-localization-keys-prefix="components.directives.grade.course-grades-grader.infiniteScroll">
        <bb-course-grades-grader-list course="courseGrades.course"
          is-first="true"
          add-more-columns="courseGradesGrader.renderMoreColumns()"
          columns="courseGradesGrader.columns"
          show-setup-overall-column="courseGradesGrader.showSetupOverallColumn"
          attendance-is-available="courseGradesGrader.attendanceIsAvailable"
          on-click-sort-icon="courseGradesGrader.onClickSortIcon(headerName)"
          sort-attributes="courseGradesGrader.sortAttributes">
        </bb-course-grades-grader-list>
      </div>
    </div>
    <div class="grade-grid-content"
      ng-if="courseGradesGrader.isGridView && courseGradesGrader.showGradeListContainer()">
      <div>
        <bb-grade-grid-reborn course="courseGrades.course"
          columns="courseGradesGrader.visibleColumns"
          attendance-is-available="courseGradesGrader.attendanceIsAvailable"
          merged-courses="courseGradesGrader.mergedCourses"
          ng-show="!courseGradesGrader.areFilterResultsEmpty">
        </bb-grade-grid-reborn>
        <div class="is-empty-page advanced-filters"
          ng-if="courseGradesGrader.areFilterResultsEmpty">
          <div class="is-empty-wrapper">
            <div class="is-empty-explanation">
              <h1 class="is-empty-heading" bb-translate>components.directives.grade.course-grades-grader.empty.advancedFilters.header</h1>
              <p bb-translate>components.directives.grade.course-grades-grader.empty.advancedFilters.description</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <!-- Student List View handles its own loading indicator and empty state -->
  <div ng-if="courseGradesGrader.isStudentListView" class="student-list-view-container">
    <bb-student-list-view class="react-container"
      course-id="courseGrades.course.id">
    </bb-student-list-view>
  </div>
  <gradebook-grid-view ng-if="courseGradesGrader.isMasteryGradebookView && courseGrades.isNewGradebookGridView === true"
                       on-view-mode-change="courseGradesGrader.onViewModeChange"
                       current-view-mode="courseGradesGrader.view"
                       is-student-id-displayable="courseGradesGrader.isStudentIdDisplayable"
                       ng-class="{'grid-view': courseGradesGrader.isGridView}">
  </gradebook-grid-view>
  <bb-mastery-gradebook-view ng-if="courseGradesGrader.isMasteryGradebookView && courseGrades.isNewGradebookGridView === true"></bb-mastery-gradebook-view>
  <bb-mastery-gradebook-view ng-if="courseGradesGrader.isMasteryGradebookView && courseGrades.isNewGradebookGridView === false"></bb-mastery-gradebook-view>
  <bb-course-grades-overview-tab ng-if="courseGradesGrader.isOverviewGradebookView"
    course-id="courseGrades.course.id"
    launch-lti-submission-view="courseGradesGrader.launchLtiSubmissionView"
    launch-lti-grading-view="courseGradesGrader.launchLtiGradingView">
  </bb-course-grades-overview-tab>
</div>
