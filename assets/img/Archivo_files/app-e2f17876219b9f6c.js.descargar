<div bb-grade-grid-menu-reborn id="{{id}}" class="reborn-dropdown-menu">
  <ul role="listbox" ng-if="gradeGridColumnOverallReborn.gradeDetail.displayGrade.isOverride || col.gradeNotations.length" class="f-dropdown f-dropdown-overflow-menu reborn-dropdown performance-code-options show notation-no-border notation-max-height ">

    <li ng-if="col.gradeNotations.length" class="performance-option-header">
        <span bb-translate>components.directives.grade.grade-input.selectPerformanceCode</span>
    </li>
    <li role="option" ng-repeat="notation in col.gradeNotations" class="performance-code-option">
      <a role="menuitem"
         ng-mousedown="gradeGridColumnOverallReborn.onDropdownMouseDown()"
         ng-click="gradeGridColumnOverallReborn.selectNotation(notation)"
         href="javascript:void(0);"
         analytics-id="components.directives.grade.grid.notation.link">
        <span class="code" aria-label="{{notation.code}}">{{notation.code}}</span>
        <span class="description notation-description-max-width" aria-label="{{notation.description}}">{{notation.description}}</span>
      </a>
    </li>
    <li role="option" ng-if="gradeGridColumnOverallReborn.gradeDetail.displayGrade.isOverride" class="undo-override">
      <a role="menuitem"
         ng-mousedown="gradeGridColumnOverallReborn.onDropdownMouseDown()"
         ng-click="gradeGridColumnOverallReborn.undoOverride()"
         href="javascript:void(0);"
         analytics-id="components.directives.grade.grade-input.undoOverride">
        <bb-svg-icon size="small" icon="undo"></bb-svg-icon>
        <bb-translate>components.directives.grade.grade-input.undoOverride</bb-translate>
      </a>
    </li>
  </ul>
</div>
