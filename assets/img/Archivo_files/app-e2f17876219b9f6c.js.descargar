  <div class="upload-list">
    <div ng-repeat="file in inProgressFiles" ng-attr-id="{{::progress.getProgressIdAttr(file)}}" bb-translate-attrs="{'aria-label':'components.directives.fileUpload.document'}" class="file-container file-container-progress">
      <div class="file-meta-container">
        <div class="file-meta">
          <ng-switch on="file.currentMimeType">
            <bb-ui-icon-large-zip ng-switch-when="application/zip" color="primary" class-name="element-image"></bb-ui-icon-large-zip>
          </ng-switch>
          <div ng-hide="file.isProcessing" class="progress-circle">
            <svg class="progress-circle-svg" viewBox="-10 -10 220 220">
              <path class="back" ng-attr-d="{{'M0,100 a100,100 0 1 0 200,0 a100,100 0 1 0 -200,0'}}" fill="transparent" />
              <path class="bar" ng-attr-d="{{'m100,0a100,100 0 0 1 0,200a100,100 0 0 1 0,-200'}}" fill="transparent" stroke-dasharray="629" stroke-dashoffset="629"/>
            </svg>
            <i class="progress-icon file-error-icon icon-exclamation" ng-if="state === 'error'"></i>
            <span class="progress-value" bb-translate translate-values="{percentage: file.currentProgress}">global.percent</span>
          </div>
          <span ng-show="file.isProcessing" class="processing-spinner">
            <div class="canvas success-state"></div>
          </span>
          <p class="progress-status">
            <span class="ellipse" bb-translate="components.directives.fileUpload.uploadingFile" translate-values="{fileName: file.fileName}"></span>
          </p>
        </div>
        <div class="content-item-controls file-container-controls">
          <button ng-hide="file.isProcessing"
                  class="button super-clear js-cancel-upload"
                  bb-translate-attrs="{'aria-label':'components.directives.fileUpload.cancelUploadText'}"
                  ng-click="progress.cancelUpload($event, file.id, file.identifier)"
                  analytics-id="components.directives.fileUpload.cancelUploadText.button">
            <bb-svg-icon size="small" icon="close"></bb-svg-icon>
          </button>
        </div>
      </div>
    </div>
  </div>
</div>
