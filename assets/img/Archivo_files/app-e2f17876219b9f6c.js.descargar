    <div class="panel-wrap">
      <header class="panel-header">
        <div class="columns" id="global-title">
          <h1 class="panel-title ng-scope" bb-translate="{{legacyTool.getToolTitleByKey(legacyTool.toolName)}}"></h1>
          <button class="menu-toggle" aria-expanded="true"
