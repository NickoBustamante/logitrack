<table bb-translate-attrs="{'aria-label': 'components.directives.grade.course-grades-grader.views.gradableItemsListViewTabLabel' }" bb-intersection-observer-root root-options class="grades-list instructor-wrapper" role="grid">
  <thead role="rowgroup">
    <tr class="row tabular-list-header course-grades-column-headers course-grades-list" ng-if="courseGradesGraderList.columns.length > 0"
      role="row">
      <th class="tabular-list-header-offset item-header-width" role="columnheader" scope="col" tabindex="-1"
          id="gradable-item-header-title" aria-sort="{{courseGradesGraderList.getSortTypeValue('item')}}">
        <span role="button" analytics-id="components.directives.grade.course-grades-grader-list.sortNameColumn" ng-click="courseGradesGraderList.onClickSort('item')"
          class="sorting-header-column" aria-live="polite" aria-atomic="true" tabindex="0">
          <span bb-translate>components.directives.grade.course-grades-grader-list.headers.name</span>
          <bb-arrow-sort-indicator sortable="true" sort="courseGradesGraderList.getSortTypeValue('item')"
            class="sort-icon js-{{courseGradesGraderList.getSortTypeValue('item')}}-icon" />
        </span>
      </th>
      <th class="hide-for-small-only column-position" role="columnheader" scope="col" tabindex="-1"
        id="gradable-item-header-category" aria-sort="{{courseGradesGraderList.getSortTypeValue('category')}}">
        <span role="button" analytics-id="components.directives.grade.course-grades-grader-list.sortCategoryColumn" ng-click="courseGradesGraderList.onClickSort('category')"
          class="sorting-header-column" aria-live="polite" aria-atomic="true">
          <span bb-translate>components.directives.grade.course-grades-grader-list.headers.category</span>
          <bb-arrow-sort-indicator sortable="true" sort="courseGradesGraderList.getSortTypeValue('category')"
            class="sort-icon js-{{courseGradesGraderList.getSortTypeValue('category')}}-icon" />
        </span>
      </th>
      <th class="hide-for-small-only column-position" role="columnheader" scope="col" tabindex="-1"
        id="gradable-item-header-dueDate" aria-sort="{{courseGradesGraderList.getSortTypeValue('dueDate')}}">
        <span role="button" analytics-id="components.directives.grade.course-grades-grader-list.sortDueDateColumn" ng-click="courseGradesGraderList.onClickSort('dueDate')"
          class="sorting-header-column" aria-live="polite" aria-atomic="true" >
          <span bb-translate>components.directives.grade.course-grades-grader-list.headers.dueDate</span>
          <bb-arrow-sort-indicator sortable="true" sort="courseGradesGraderList.getSortTypeValue('dueDate')"
            class="sort-icon js-{{courseGradesGraderList.getSortTypeValue('dueDate')}}-icon" />
        </span>
      </th>
      <th class="hide-for-small-only column-position" role="columnheader" scope="col" tabindex="-1"
        id="gradable-item-header-gradingStatus" aria-sort="{{courseGradesGraderList.getSortTypeValue('gradingStatus')}}">
        <span role="button" analytics-id="components.directives.grade.course-grades-grader-list.sortStatusColumn" ng-click="courseGradesGraderList.onClickSort('gradingStatus')"
          class="sorting-header-column" aria-live="polite" aria-atomic="true">
          <span bb-translate>components.directives.grade.course-grades-grader-list.headers.progress</span>
          <bb-arrow-sort-indicator sortable="true" sort="courseGradesGraderList.getSortTypeValue('gradingStatus')"
            class="sort-icon" />
        </span>
      </th>
      <th class="hide-for-small-only column-position" role="columnheader" scope="col" tabindex="-1"
        id="gradable-item-header-post" aria-sort="{{courseGradesGraderList.getSortTypeValue('post')}}">
        <span role="button" analytics-id="components.directives.grade.course-grades-grader-list.sortPostColumn" ng-click="courseGradesGraderList.onClickSort('post')"
          class="sorting-header-column" aria-live="polite" aria-atomic="true">
          <span bb-translate>components.directives.grade.course-grades-grader-list.headers.post</span>
          <bb-arrow-sort-indicator sortable="true" sort="courseGradesGraderList.getSortTypeValue('post')"
            class="sort-icon" />
        </span>
      </th>
      <th class="hide-for-small-only action-header-width focusable-th" role="columnheader" scope="col" tabindex="-1">
        <span class="sr-only" bb-translate>components.directives.grade.course-grades-grader-list.headers.reorderItem</span>
      </th>
      <th class="hide-for-small-only action-header-width focusable-th" role="columnheader" scope="col" tabindex="-1">
        <span class="sr-only" bb-translate>components.directives.grade.course-grades-grader-list.headers.moreOptions</span>
      </th>
    </tr>
  </thead>
  <tbody role="rowgroup">
  <tr role="presentation" ng-if="courseGradesGraderList.isAddContentButtonVisible">
    <td role="cell" tabindex="-1">
      <bb-add-content-button position-before="'start'" item-name="courseGradesGraderList.columns[0].columnName"
        context-area="courseGradesGraderList.contextArea" show-menu-override="!courseGradesGraderList.hasColumns"
        always-show="isFirst" show-add-text-column="courseGradesGraderList.isTextColumnAvailable"
        show-add-attendance="attendanceIsAvailable() && !courseGradesGraderList.attendanceColumnExists"></bb-add-content-button>
    </td>
  </tr>
  <tr role="row" ng-repeat-start="column in courseGradesGraderList.columns track by column.id"
      class="drag-element tabular-row grade-list js-row"
      ng-class="{'no-hover': (course().isComplete() || (column.isAttendance() && !attendanceIsAvailable)), 'last-tabular-row-container': $last, 'element-disabled': courseGradesGraderList.isDisabled(column)}"
      bb-grader-column
      bb-drop-handler
      column="column" course="course()" is-course-view="true"
      category-map="courseGradesGraderList.categoryMap"
      attendance-column-exists="courseGradesGraderList.attendanceColumnExists"
      attendance-is-available="attendanceIsAvailable()"
      is-text-column-available="courseGradesGraderList.isTextColumnAvailable"
      on-move-handler="courseGradesGraderList.onMoveGraderItem"
      next-content-id="courseGradesGraderList.columns[$index+1].id"
      previous-content-id="courseGradesGraderList.columns[$index-1].id"
      content="column"
  >
  </tr>
  <tr ng-repeat-end role="presentation"  bb-intersection-observer-target
              intersection-observer-target-id="course-grades-intersection-observer-span"
              in-callback="courseGradesGraderList.renderMoreColumns()">
        <td role="cell" tabindex="-1" ng-if="courseGradesGraderList.isAddContentButtonVisible">
        <bb-add-content-button position-after="column.id" item-name="column.columnName"
          context-area="courseGradesGraderList.contextArea" show-menu-override="!courseGradesGraderList.hasColumns"
                               show-add-text-column="courseGradesGraderList.isTextColumnAvailable"
          show-add-attendance="attendanceIsAvailable() && !courseGradesGraderList.attendanceColumnExists"></bb-add-content-button>
        </td>
      </tr>
      </tbody>
      <tfoot></tfoot>
    </table>
    <bb-setup-overall-grade ng-if="courseGradesGraderList.showSetupOverallGradeMessage && courseGradesGraderList.canModify"
      course-id="courseGradesGraderList.course.id"
      setup-overall-grade-hide-message-callback="courseGradesGraderList.setupOverallGradeHideMessageCallback()">
    </bb-setup-overall-grade>
