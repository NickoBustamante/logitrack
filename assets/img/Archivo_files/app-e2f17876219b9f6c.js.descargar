  <caption role="alert" class="sr-only">{{ ::config().title }}</caption>
  <thead>
    <tr class="table-headings">
      <th class="table-heading"
          scope="col"
          ng-style="{ 'width': column.widthPercentage, 'min-width': column.widthPercentage }"
          ng-repeat="column in config().columns"
          ng-if="column.visible"
          data-heading-index="{{ ::$index }}"
          ng-class="{
            'sortable-header': column.sort,
            'ascending': $index === config().currentSortColumnIndex && config().currentSortDirection === 'asc',
            'descending': $index === config().currentSortColumnIndex && config().currentSortDirection === 'desc'}"
          ng-attr-aria-sort="{{ $index === config().currentSortColumnIndex && config().currentSortDirection === 'asc' ? 'ascending' :
          $index === config().currentSortColumnIndex && config().currentSortDirection === 'desc' ? 'descending' : undefined }}">
        <button class="button-anchor" ng-if="column.sort" analytics-id="components.directives.table.sort.button">
          <span class="table-heading-contents" ng-class="{ 'sr-only': column.srHeading }">{{ column.heading }}</span>
          <i class="sort-control">
            <i class="arrow up" ></i>
            <i class="arrow down"></i>
          </i>
        </button>
        <span ng-if="!column.sort" class="table-heading-contents" ng-class="{ 'sr-only': column.srHeading }">{{ column.heading }}</span>
      </th>
    </tr>
  </thead>
  <tbody ng-if="table.initialDataLoaded || config().showRowsDuringRefresh">
    <tr ng-repeat="item in tableData()"
        class="table-row"
        ng-class="{'clickable': config().rowClickFn }"
        ng-click="config().rowClickFn ? config().rowClickFn(item): null"
        ng-transclude
        analytics-id="components.directives.table.rowClick"></tr>
  </tbody>
</table>
<div ng-if="config().pageSize && table.initialDataLoaded">
  <div bb-infinite-scroll="table.showMore()"
       infinite-scroll-immediate-check="false"
       infinite-scroll-total-count="config().totalCount"
       infinite-scroll-current-count="tableData().length"
       infinite-scroll-load-limit="config().pageSize"
       infinite-scroll-container="config().infiniteScrollContainerSelector()"
       infinite-scroll-tray-id="{{::config().instanceId}}-scroll-tray"></div>
</div>
<div class="spinner bb-secondary-color-2" ng-show="!table.initialDataLoaded"></div>`},142072(e,t,n){"use strict";n.d(t,{A:()=>s});var a=n(623162),i=n(570733);let s="ultra.components.directives.bbUiIcon.large.Survey";(0,a.z)(i.B,s,"bbUiIconLargeSurvey")},149411(e,t,n){"use strict";n.d(t,{A:()=>a});let a=n(259301)._hB},150204(e,t,n){"use strict";n.d(t,{$:()=>o});var a=n(764767),i=n(129093),s=n(514041),r=n(865004);let o=({email:e,exitCallback:t})=>{let n=!!e,o=(0,r.W)(),[l,d]=(0,s.useState)(!0),c=()=>{d(!1)};return s.createElement(i.gT,{analyticsId:"course.content.ltiNeedsApproval",className:"react-container",open:l,onClose:c,TransitionProps:{onExited:()=>{t(),d(!0)}}},s.createElement(a.Fv,{analyticsId:"lti.modal.needs-approval.title",onClose:c,closeLabel:o("global.close")},o("course.content.ltiNeedsApprovalTitle")),s.createElement(a.Wy,{analyticsId:"lti.modal.needs-approval.content"},n?s.createElement(s.Fragment,null,s.createElement(a.pP,{analyticsId:"lti.modal.needs-approval.content.description"},o("course.content.ltiNeedsApprovalDescription")),s.createElement(a.pP,{analyticsId:"lti.modal.needs-approval.content.email"},s.createElement(a.T,{href:`mailto:${e}`,analyticsId:"components.services.lti.needsApproval.email.link"},e))):s.createElement(a.pP,{analyticsId:"lti.modal.needs-approval.content.no-email"},o("course.content.ltiNeedsApprovalDescriptionNoEmail"))),s.createElement(a.gS,{analyticsId:"lti.modal.needs-approval.actions"},s.createElement(a.Hu,{analyticsId:"global.ok",onClick:c},o("global.ok"))))}},150463(e,t,n){"use strict";n.d(t,{$A:()=>a,Ky:()=>l,Um:()=>o,Vn:()=>r,g1:()=>s,gR:()=>i});let a=44,i=60,s=38,r="& .bb-editor-root .bb-editor-container.is-read-only .ql-editor",o=e=>`solid 1px ${e.palette.border.main}`,l=(e,t,n=!1)=>`${n?"inset ":""}${e}px ${t}px 0px 0px rgba(0, 0, 0, 0.05)`},152651(e,t,n){var a=n(371818),i=n(608205),s=new a({id:"icon-medium-conversation",use:"icon-medium-conversation-usage",viewBox:"0 0 24 24",content:'<symbol fill="none" xmlns="http: