  modal-translate-options="modalTranslateOptions"
  analytics-id-tag-prefix="components.directives.groupAttemptAccessControlDialog">

  <div name="modal-contents">

    <div class="queue">
      <div class="owner user-tile">
        <div>
          <bb-avatar user="owner"></bb-avatar>
          <bb-username user="owner"></bb-username>
        </div>
      </div>
      <div class="user-tile queuer" ng-repeat="user in queuedUsers track by user.id" ng-class="'queuer-' + $index">
        <div>
          <bb-avatar user="user"></bb-avatar>
          <bb-username user="user"></bb-username>
        </div>
      </div>
    </div>

    <p ng-bind-html="::modalStrings.instructions"></p>
  </div>
  <span name="modal-footer-button-primary">
    <button class="button confirm-ok js-primary-button" ng-click="okAction()" ng-if="!hideOK" analytics-id="primary.ok.action.button">{{::modalStrings.ok}}</button>
    <button class="button confirm-cancel js-secondary-button" ng-click="cancelAction()" ng-if="hideOK" analytics-id="secondary.cancel.action.button">{{::modalStrings.cancel}}</button>
  </span>
  <span name="modal-footer-button-secondary">
    <button class="button button--secondary confirm-cancel js-secondary-button" ng-click="cancelAction()" ng-if="!hideOK" analytics-id="secondary.cancel.action.button">{{::modalStrings.cancel}}</button>
  </span>
</bb-modal>
