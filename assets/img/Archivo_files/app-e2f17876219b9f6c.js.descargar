  ng-click="!isDisabled && gradeGridColumnReborn.enterEditor($event)"
  analytics-id="components.directives.grade.grid.gradeGridColumnReborn.enterEdit"
  role="gridcell"
  aria-readonly="{{ gradeGridColumnReborn.canGradeCell() ? 'false' : 'true' }}"
>
  <div class="exception-icon" ng-if="gradeGridColumnReborn.showExceptionIcon">
    <button
      bb-complex-tooltip
      enhanced-tooltip="true"
      bb-translate-attrs="{'aria-label': 'components.directives.grade.submission-list-row.exception.tooltipButtonAriaLabel'}"
      translate-attrs-values="{name: gradeGridColumnReborn.getShortFormatUsername()}"
      tooltip-position="top-center"
      tooltip-center-content="true"
      tooltip-enable-on-mouse-over-for-all-breakpoints="true"
      tooltip-enable-on-mouse-leave-for-all-breakpoints="true"
      tooltip-scope="gradeGridColumnReborn.tooltipScope"
      tooltip-template="{{gradeGridColumnReborn.getTooltipTemplate()}}"
      analytics-id="components.directives.grade.grid.gradeGridColumnReborn.exception.button">
      <bb-ui-icon-small-time-extra></bb-ui-icon-small-time-extra>
    </button>
  </div>
  <div class="score hide" aria-label="{{gradeGridColumnReborn.ariaLabelContent}}">
      <bb-complete-incomplete-grade-pill
        ng-if="gradeGridColumnReborn.isSchemaTypeComplete() && gradeGridColumnReborn.showCompletePill() && gradeGridColumnReborn.isScorable()"
        class="complete-pill"
        is-complete="gradeGridColumnReborn.isStatusComplete()"
        grade-value="gradeGridColumnReborn.score"
        on-blur="gradeGridColumnReborn.onCompleteInputBlur"
        total-points="col.data.possible">
      </bb-complete-incomplete-grade-pill>
    <div id="displayedScore" class="hide" ng-class="{'text-grade': gradeGridColumnReborn.isTextColumn()}" ng-if="gradeGridColumnReborn.isScorable() || gradeGridColumnReborn.isTextColumn()">
      <span id="display" class="hide" ng-class="{'ellipse': !gradeGridColumnReborn.isTextColumn()}" ng-show="!gradeGridColumnReborn.isSchemaTypeComplete()"></span>
      <span id="posted"  class="grade-posted-symbol hide" bb-translate>components.directives.grade.grid.postedLabel</span>
      <span id="pastDueZero" class="past-due-zero-symbol hide" bb-translate>components.directives.grade.grid.pastDueZero</span>
      <span id="slash" class="slash hide"></span>
      <span id="pointsPossible" class="pointsPossible hide"></span>
      <span id="exempt" class="item-exempt-symbol hide" bb-translate>components.directives.grade.grid.exemptLabel</span>
    </div>

    <div id="noSubmission" class="hide" ng-show="gradeGridColumnReborn.isScorable() || gradeGridColumnReborn.isTextColumn()" aria-label="{{gradeGridColumnReborn.ariaLabelContent}}">
      <span
         analytics-id="components.directives.grade.grid.noSubmission">-</span>
    </div>

    <div id="newSubmission" class="hide" ng-show="gradeGridColumnReborn.isScorable()" aria-label="{{gradeGridColumnReborn.ariaLabelContent}}">
      <span class="new-submission" bb-translate>components.directives.grade.grid.newSubmissionLabel</span>
    </div>
    <div id="displayedStatus" ng-show="!gradeGridColumnReborn.isScorable()" ng-if="!gradeGridColumnReborn.isTextColumn()">
      <bb-complete-incomplete-grade-pill
        ng-show="gradeGridColumnReborn.isPermanentAnonymous()"
        class="complete-pill"
        is-complete="gradeGridColumnReborn.isStatusComplete()"
        grade-value="gradeGridColumnReborn.score"
        >
      </bb-complete-incomplete-grade-pill>
      <span id="display-non-scorable" class="ellipse" ng-show="!gradeGridColumnReborn.isPermanentAnonymous()" bb-translate>{{gradeGridColumnReborn.latestAttemptStatus()}}</span>
    </div>

    <span id="blank" class="sr-only">
      {{gradeGridColumnReborn.ariaLabelContent}}
    </span>
  </div>
  <div id="group" class="group-label" ng-if="!gradeGridColumnReborn.isRestrictedGroupContent && gradeGridColumnReborn.isScorable()">{{gradeGridColumnReborn.group.groupTitle}}</div>
  <div id="ungraded" class="ungraded hide" ng-show="gradeGridColumnReborn.isScorable()">
    <span class="ellipse">{{gradeGridColumnReborn.ungraded}}</span>
  </div>
  <div class="anonymous hide">
    <button
      bb-tooltip
      enhanced-tooltip="true"
      tooltip-position="bottom-center"
      class="anonymous-button"
      analytics-id="components.directives.grade.grid.anonymous.button"
      bb-translate-attrs="gradeGridColumnReborn.getAnonymousTooltipParameters()">
      <span bb-translate>components.directives.grade.grid.anonymous.label</span>
    </button>
  </div>
</div>
