  <div ng-if="!displayGrade.shouldShowRubricButton() && !displayGrade.shouldShowRubricDiv()">
    <div ng-if="!(isGroupGradeMultiple() && !showNotGraded())"
         ng-class="{ 'show-total': displayGrade.gradeDisplayItem.shouldShowTotalPoints(),
                     'final-grade': finalGrade(),
                     'na': displayGrade.gradeDisplayItem.displayValue == null,
                     'cursor-pointer': displayGrade.cursorPointer,
                     'defaultCursor': displayGrade.cursorDefault}"
         class="wrapping-input-style {{displayGrade.colorClass}}"
         ready="{{::displayGrade.fullDisplayGrade && !displayGrade.noGradeToDisplay() || undefined}}">
      <ng-switch on="displayGrade.schema.scaleType">
        <span ng-switch-default>
          <span ng-if="displayGrade.fullDisplayGrade != null && !overallGradePeekSref" class="grade-input-display ready" bb-translate-attrs="{ title: '{{displayGrade.gradeDisplayItem.perfCodeDesc || translateKey}}'}">{{displayGrade.fullDisplayGrade}}</span>
          <a ng-if="displayGrade.fullDisplayGrade != null && overallGradePeekSref"
             class="grade-input-display ready"
             bb-peek-sref="{{overallGradePeekSref}}"
             bb-translate-attrs="{ title: '{{displayGrade.gradeDisplayItem.perfCodeDesc || translateKey}}'}"
             analytics-id="components.directives.grade.display-grade.scale.fullDisplayGrade.link">
            {{displayGrade.fullDisplayGrade}}
          </a>
          <span ng-if="displayGrade.fullDisplayGrade == null && !overallGradePeekSref" class="grade-input-display" bb-translate-attrs="{ title: '{{displayGrade.gradeDisplayItem.perfCodeDesc || translateKey}}'}">{{::displayGrade.getNoGradeDisplay()}}</span>
          <a ng-if="displayGrade.fullDisplayGrade == null && overallGradePeekSref"
             class="grade-input-display"
             bb-peek-sref="{{overallGradePeekSref}}"
             bb-translate-attrs="{ title: '{{displayGrade.gradeDisplayItem.perfCodeDesc || translateKey}}'}"
             analytics-id="components.directives.grade.display-grade.scale.getNoGradeDisplay.link">
            {{::displayGrade.getNoGradeDisplay()}}
          </a>
        </span>
        <span ng-switch-when="SCORE">
          <!-- Accommodate for hiding of points possible in small format -->
          <span ng-if="displayGrade.gradeDisplayItem.displayValue != null && !overallGradePeekSref" class="grade-input-display ready">{{displayGrade.gradeDisplayItem.displayValue}}</span>
          <a ng-if="displayGrade.gradeDisplayItem.displayValue != null && overallGradePeekSref"
             class="grade-input-display ready"
             bb-peek-sref="{{overallGradePeekSref}}"
             analytics-id="components.directives.grade.display-grade.score.fullDisplayGrade.link">
            {{displayGrade.gradeDisplayItem.displayValue}}
          </a>
          <span ng-if="displayGrade.gradeDisplayItem.displayValue == null && !overallGradePeekSref" class="grade-input-display">{{::displayGrade.getNoGradeDisplay()}}</span>
          <a ng-if="displayGrade.gradeDisplayItem.displayValue == null && overallGradePeekSref"
             class="grade-input-display"
             bb-peek-sref="{{overallGradePeekSref}}"
             analytics-id="components.directives.grade.display-grade.score.getNoGradeDisplay.link">
            {{::displayGrade.getNoGradeDisplay()}}
          </a>
          <span ng-if="displayGrade.shouldShowPointsPossible()" class="points-text" bb-translate translate-values="{total: gradeDetail.pointsPossible || column.possible}">components.directives.grade.display-grade.points</span>
        </span>
      </ng-switch>
    </div>
    <div ng-if="isGroupGradeMultiple() && !showNotGraded()" class="wrapping-input-style is-multiple">
      <div ng-if="overallGradePeekSref" class="group-multiple" bb-peek-sref="{{overallGradePeekSref}}" bb-translate>components.directives.grade.display-grade.multiple</div>
      <div ng-if="!overallGradePeekSref" class="group-multiple" bb-translate>components.directives.grade.display-grade.multiple</div>
    </div>
  </div>
  <div ng-if="displayGrade.shouldShowRubricButton()">
    <a ng-if="!displayGrade.shouldShowRubricEvaluation()"
       bb-peek-sref="rubric-view"
       class="js-rubric-view wrapping-input-style clear cursor-pointer"
       ng-class="displayGrade.colorClass"
       analytics-id="components.directives.grade.display-grade.rubric.link">
      <span>
        <bb-svg-icon size="small" icon="rubric"></bb-svg-icon>
        <span class="grade-input-display ready" ng-if="displayGrade.gradeDisplayItem.displayValue != null">{{displayGrade.gradeDisplayItem.displayValue}}&nbsp</span>
        <span class="grade-input-display ready" ng-if="displayGrade.gradeDisplayItem.displayValue == null">{{::displayGrade.getNoGradeDisplay()}}</span>&nbsp;
        <span ng-if="displayGrade.shouldShowPointsPossible()" class="points-text" bb-translate translate-values="{total: gradeDetail.pointsPossible || column.possible}">components.directives.grade.display-grade.points</span>
      </span>
    </a>
    <a ng-if="displayGrade.shouldShowRubricEvaluation()"
       bb-peek-sref="rubric-evaluation({groupId: displayGrade.attempt.groupId})"
       class="js-rubric-evaluation wrapping-input-style clear cursor-pointer"
       ng-class="displayGrade.colorClass"
       analytics-id="components.directives.grade.display-grade.rubricEvaluation.link">
      <span>
        <bb-svg-icon size="small" icon="rubric"></bb-svg-icon>
        <span class="grade-input-display ready" ng-if="displayGrade.gradeDisplayItem.displayValue != null">{{displayGrade.gradeDisplayItem.displayValue}}&nbsp</span>
        <span class="grade-input-display ready" ng-if="displayGrade.gradeDisplayItem.displayValue == null">{{::displayGrade.getNoGradeDisplay()}}&nbsp</span>&nbsp;
        <span ng-if="displayGrade.shouldShowPointsPossible()" class="points-text" bb-translate translate-values="{total: gradeDetail.pointsPossible || column.possible}">components.directives.grade.display-grade.points</span>
      </span>
    </a>
  </div>
  <div ng-if="displayGrade.shouldShowRubricDiv() && displayGrade.shouldShowRubricEvaluation()"
       class="wrapping-input-style clear"
       ng-class="displayGrade.colorClass">
    <span>
      <bb-svg-icon size="small" icon="rubric"></bb-svg-icon>
      <span class="grade-input-display ready" ng-if="displayGrade.gradeDisplayItem.displayValue != null">{{displayGrade.gradeDisplayItem.displayValue}}</span>
      <span class="grade-input-display ready" ng-if="displayGrade.gradeDisplayItem.displayValue == null">{{::displayGrade.getNoGradeDisplay()}}</span>&nbsp;
      <span ng-if="displayGrade.shouldShowPointsPossible()" class="points-text" bb-translate translate-values="{total: gradeDetail.pointsPossible || column.possible}">components.directives.grade.display-grade.points</span>
    </span>
  </div>
</div>
<bb-complete-incomplete-grade-pill
  class="js-complete-pill"
  ng-if="displayGrade.isSchemaTypeComplete()"
  is-rubric-enabled="displayGrade.shouldShowRubricButton()"
  is-complete="displayGrade.isStatusComplete()"
>
</bb-complete-incomplete-grade-pill>
