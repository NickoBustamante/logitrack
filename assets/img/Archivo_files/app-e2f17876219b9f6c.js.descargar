 d="M5 3c.5523 0 1 .4477 1 1v4c0 .5523-.4477 1-1 1s-1-.4477-1-1V4c0-.5523.4477-1 1-1zm4 3c0-.5523-.4477-1-1-1s-1 .4477-1 1v2c0 .5523.4477 1 1 1s1-.4477 1-1V6zm2 0c.5523 0 1 .4477 1 1v1c0 .5523-.4477 1-1 1s-1-.4477-1-1V7c0-.5523.4477-1 1-1zm-6 4c-.5523 0-1 .4477-1 1s.4477 1 1 1h3c.5523 0 1-.4477 1-1s-.4477-1-1-1H5z" /><path fill="currentColor" stroke="transparent" fill-rule="evenodd" d="M13 10c-1.6569 0-3 1.3431-3 3s1.3431 3 3 3 3-1.3431 3-3-1.3431-3-3-3zm-1 3c0-.5523.4477-1 1-1s1 .4477 1 1-.4477 1-1 1-1-.4477-1-1z" clip-rule="evenodd" /></symbol>'});i.add(s),e.exports=s},234127(e){e.exports=`<button ng-if="!overflowMenu.isSingleMode() && overflowMenu.menuItems.length > 0"
        ng-show="overflowMenu.show()"
        ng-disabled="isDisabled()"
        class="overflow-menu-button"
        data-dropdown="{{elementId}}-menu-icon-dropdown"
        data-options="{{::overflowMenu.menuDirection}}"
        aria-haspopup="true"
        title="{{overflowMenu.getButtonAriaLabel()}}"
        ng-click="overflowMenu.showMenu=true"
        aria-label="{{overflowMenu.getButtonAriaLabel()}}"
        analytics-id="{{analyticsIdTagPrefix}}.showMenu.button">
  <bb-svg-icon size="small" icon="menu"></bb-svg-icon>
</button>

<!--Single mode toggle button-->
<button ng-if="overflowMenu.isSingleMode() && overflowMenu.menuItems.length > 0"
        ng-show="overflowMenu.singleMenuItem.show()"
        ng-click="overflowMenu.showMenu=true; overflowMenu.singleMenuItem.onClick()"
        ng-disabled="isDisabled()"
        class="overflow-menu-button"
        bb-click-focus="{{overflowMenu.singleMenuItem.hasConfirmation() ? '' : overflowMenu.singleMenuItem.bbClickFocus}}"
        data-dropdown="{{elementId}}-menu-icon-dropdown"
        data-options="{{::overflowMenu.menuDirection}}"
        aria-haspopup="true"
        title="{{overflowMenu.singleMenuItem.ariaLabel()}}"
        aria-label="{{overflowMenu.singleMenuItem.ariaLabel()}}"
        analytics-id="{{analyticsIdTagPrefix}}.showSingleMenu.button">
  <bb-svg-icon size="small" icon="{{overflowMenu.singleMenuItem.icon}}" status="{{overflowMenu.singleMenuItem.status}}"></bb-svg-icon>
</button>

<!--Menu -->
<div id="{{::elementId}}-menu-icon-dropdown" ng-if="overflowMenu.showMenu" ng-show="overflowMenu.show()" class="f-dropdown f-dropdown-overflow-menu"
     data-dropdown-content aria-autoclose="false">
  <!--Menu item list-->
  <ul ng-show="!overflowMenu.isSingleMode()"
      class="js-menu-item-list"
      ng-class="{'with-option-text': overflowMenu.hasOptionText(), 'ignore-accordion': overflowMenu.ignoreAccordion()}"
      role="menu">
    <li ng-repeat="menuItem in overflowMenu.menuItems | filter:overflowMenu.visibleMenuItemsFilter track by menuItem.id"
      bb-click-to-invoke-child="a.js-menu-item-link"
      custom-attributes="{{ ::menuItem.addAdditionalAttributes() }}"
      id="{{ ::menuItem.id + '_li' }}"
      role="menuitem">
      <a href="javascript:void(0);"
         ng-if="!menuItem.disable()"
         class="js-menu-item-link"
         id="{{::menuItem.id}}"
         ng-click="menuItem.onClick()"
         bb-click-focus="{{menuItem.hasConfirmation() ? '' : menuItem.bbClickFocus}}"
         aria-label="{{menuItem.ariaLabel()}}"
         ng-keydown="overflowMenu.onOptionKeydown($event)"
         analytics-id="{{::overflowMenu.buildAnalyticsId(menuItem)}}">
        <!-- Icon -->
        <bb-overflow-menu-icon icon-name="{{menuItem.icon}}" status="{{menuItem.status}}"></bb-overflow-menu-icon>
        <!-- Label -->
        <span bb-translate>{{::menuItem.labelKey}}</span>
        <p ng-if="::menuItem.textKey" class="option-text" bb-translate>{{::menuItem.textKey}}</p>
      </a>
      <a href="javascript:void(0);"
         ng-if="menuItem.disable()"
         class="js-menu-item-link disable"
         ng-click="menuItem.onClick()"
         aria-disabled="true"
         tabindex="-1"
         bb-tooltip
         enhanced-tooltip="true"
         tooltip-position="bottom"
         title="{{menuItem.disableInfo}}"
         analytics-id="{{analyticsIdTagPrefix}}.{{::menuItem.labelKey}}.disabled.link">
        <!-- Icon -->
        <bb-overflow-menu-icon icon-name="{{menuItem.icon}}" status="{{menuItem.status}}"></bb-overflow-menu-icon>
        <!-- Label -->
        <span bb-translate>{{::menuItem.labelKey}}</span>
        <p ng-if="::menuItem.textKey" class="option-text" bb-translate>{{::menuItem.textKey}}</p>
        <span class="sr-only">{{menuItem.disableInfo}}</span>
      </a>
    </li>
  </ul>

  <!-- Confirmation - shows when the corresponding button is pressed from the menu -->
  <div role="alertdialog"
       aria-label="{{overflowMenu.getTextByKey(menuItem.options.confirmationOptions.titleKey)}}"
       ng-repeat="menuItem in overflowMenu.confirmationNeededMenuItems"
       ng-show="menuItem.show()" id="{{::menuItem.confirmationId}}"
       class="menu-icon-confirmation"
       ng-class="{'menu-icon-confirmation-single-mode': overflowMenu.isSingleMode()}">
    <h1 aria-describedby="{{::('overflow-confirmation-instructions' + menuItem.confirmationId)}}"
        bb-focus="menuItem.isConfirmationMenuVisible()"
        ng-blur="menuItem.blur()"
        keep-trigger-focus="true">{{overflowMenu.getTextByKey(menuItem.options.confirmationOptions.titleKey)}}</h1>
    <p id="{{'overflow-confirmation-instructions' + menuItem.confirmationId}}">{{overflowMenu.getTextByKey(menuItem.options.confirmationOptions.instructionsKey)}}</p>
    <div class="choice" ng-show="menuItem.hasChoices()" ng-repeat="choice in menuItem.options.confirmationOptions.choices">
      <input id="{{choice.key + elementId}}"
             ng-disabled="choice.isDisable"
             ng-model="choice.value"
             type="checkbox"
             ng-keydown="overflowMenu.onOptionKeydown($event)"
             analytics-id="{{analyticsIdTagPrefix}}.isDisabled.input.checkbox"/>
      <label for="{{choice.key + elementId}}" bb-translate="{{choice.localizedKey}}"></label>
    </div>
    <hr>
    <div class="menu-icon-confirmation-footer">
      <button class="button button--secondary"
              ng-click="menuItem.onCancel()"
              analytics-id="{{analyticsIdTagPrefix}}.cancel.button">
        <span bb-translate>global.cancel</span>
      </button>
      <button class="button js-delete-confirm"
              ng-click="menuItem.onConfirm($event)"
              bb-click-focus="{{::menuItem.bbClickFocus}}"
              analytics-id="{{analyticsIdTagPrefix}}.confirm.button">
        <span bb-translate>{{::menuItem.options.comfirmLabelKey || menuItem.labelKey}}</span>
      </button>
    </div>
  </div>
</div>
