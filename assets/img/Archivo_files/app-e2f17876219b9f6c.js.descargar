<div class="filter-list-content">
  <div class="filter-panel-container">
    <div class="filter-panel-header">
      <div class="filter-panel-title-wrapper">
        <h3 class="filter-panel-title" bb-translate>components.directives.grade.filter-panel.title</h3>
        <button type="button"
          class="filter-panel-close-button"
          data-is-visible="true"
          bb-translate-attrs="{'aria-label': 'components.directives.grade.filter-panel.closeFilterPanel'}"
          ng-click="gradeGridSearchFilterReborn.closeFilterCriteria()"
          analytics-id="components.directives.grade.filterPanel.close.button"
        >
          <div>
            <bb-svg-icon size="small" icon="close"></bb-svg-icon>
          </div>
        </button>
      </div>
      <button class="filter-panel-clear-all is-disabled"
              ng-disabled= "!gradeGridSearchFilterReborn.getCheckedMergedCourse() > 0"
              ng-class="{'filter-panel-clear-all-active': gradeGridSearchFilterReborn.getCheckedMergedCourse() > 0}"
              ng-click="gradeGridSearchFilterReborn.clearAll()"
              analytics-id="components.directives.grade.filter-panel.clearAll"
              bb-translate>
              components.directives.grade.filter-panel.clearAll
      </button>
    </div>
    <div class="filter-panel-block" id="sources-block" ng-repeat="criteriaBlock in gradeGridSearchFilterReborn.criteriaBlocks ">
        <div class="filter-panel-block-header" id ={{::criteriaBlock.id}}>
            <h4 class="filter-panel-block-title" course-org-token-resolver bb-translate>components.directives.grade.filter-panel.mergedCourseTitle</h4>
            <button type="button" class="filter-panel-toggle-button"
                    ng-class="{'filter-panel-block-toggle-close': !criteriaBlock.expanded }"
                    ng-click="gradeGridSearchFilterReborn.collapseMergedCourse(criteriaBlock)"
                    aria-label="{{gradeGridSearchFilterReborn.getToggleButtonLabel(criteriaBlock)}}"
                    analytics-id="components.directives.grade.filterPanel.mergedCourse.collapse.button"
            >
            <bb-svg-icon size="small" icon="arrow-down"></bb-svg-icon>
            </button>
          </div>
        <div class="filter-panel-groups" ng-show="criteriaBlock.expanded">
          <div class="filter-panel-group">
            <div class="filter-panel-item" ng-repeat="criteriaDetail in criteriaBlock.criteriaDetails track by $index" >
              <div class="is-enabled filter-panel-item-checkbox" ng-show="!criteriaDetail.ui.hidden">
                <input type="checkbox" id={{::criteriaDetail.id}}
                  class="bb-Checkbox-checkboxInput foundation-overrides"
                  ng-model="criteriaDetail.ui.checked"
                  ng-change="gradeGridSearchFilterReborn.filterMergedCourse(criteriaDetail)"
                  analytics-id="components.directives.grade.filterPanel.mergedCourse.input.checkbox">
                  <label class="foundation-overrides" for={{::criteriaDetail.id}}>
                    <div class="check-box-label">
                      <span>{{::criteriaDetail.childCourse.name}}</span>
                      <bb-svg-icon icon="check" size="inline"></bb-svg-icon>
                    </div>
                </label>
              </div>
            </div>
          </div>
        </div>
      </div>
  </div>
</div>
`},657692(e){e.exports=`<div class="grade-grid-cell grade-grid-header-cell">
  <div class="content content-header-bg content-header cursor-pointer" tabindex="0" role="columnheader"
       ng-class="{'is-restricted': columnMetadata.isHiddenFromStudents(), 'is-unavailable': !gradeGridColumnHeaderReborn.toolAvailable || !col.hasContextMenuOptions()}"
       ng-click="gradeGridColumnHeaderReborn.popupMenu($event)"
       analytics-id="components.directives.grade.grid.gradeGridColumnHeaderReborn.popupMenu"
       ng-if="!gradeGridColumnHeaderReborn.gradeGridRebornController.gridData.shouldAllowSorting(columnMetadata)">
      <div bb-content-item-icon content-column="columnMetadata" show-alert-icon="showAlertIcon()" is-medium-content-item-icon="true" class="element-image" role="presentation"></div>
      <div class="ellipse grade-name"
           aria-labelledby="summary-info-{{columnMetadata.id}}" aria-label="{{columnMetadata.columnName}}">{{columnMetadata.columnName}}</div>
      <div>
        <span ng-if="columnMetadata.isFormative" class="formative-label"
              id="summary-formative-{{columnMetadata.id}}"
              aria-hidden="true"
              bb-translate>
              components.directives.grade.grid.formative
        </span>
      </div>
  </div>
  <div class="content content-header-bg content-header"
       ng-class="{'is-restricted': columnMetadata.isHiddenFromStudents()}"
       ng-if="gradeGridColumnHeaderReborn.gradeGridRebornController.gridData.shouldAllowSorting(columnMetadata)">
    <div bb-content-item-icon content-column="columnMetadata" show-alert-icon="showAlertIcon()" is-medium-content-item-icon="true" class="element-image content-icon content-item-icon-bg-{{columnMetadata.id}}" role="button"
         ng-click="gradeGridColumnHeaderReborn.popupMenu($event)"
         analytics-id="components.directives.grade.grid.gradeGridColumnHeaderReborn.popupMenu"
         ng-class="{'is-unavailable': !gradeGridColumnHeaderReborn.toolAvailable || !col.hasContextMenuOptions()}"
         aria-haspopup="true" aria-expanded="{{gradeGridColumnHeaderReborn.isPopupOpen}}"
         aria-describedby="summary-info-{{columnMetadata.id}}"
         tabindex="0" aria-label="{{columnMetadata.columnName}}"></div>
    <div class="grade-name">
      <div class="sorting-header-column content-item-name-bg-{{columnMetadata.id}} js-column-sorting"
           ng-click="gradeGridColumnHeaderReborn.gradeGridRebornController.onClickSortIcon(columnMetadata.id,columnMetadata)"
           bb-translate-attrs="{'aria-label': '{{gradeGridColumnHeaderReborn.getAriaLabelStringForColumnHeader(columnMetadata)}}'}"
           translate-attrs-values="{columnName:columnMetadata.columnName}"
           analytics-id="components.directives.grade.grid.gradeGridColumnHeaderReborn.columnSorting"
           tabindex="0"
           role="button">
        <span class="ellipse grade-header-name" title="{{columnMetadata.columnName}}">{{columnMetadata.columnName}}</span>
        <bb-arrow-sort-indicator bb-foundation-defer sortable="true"
                                 sort="gradeGridColumnHeaderReborn.gradeGridRebornController.getSortTypeValue(columnMetadata.id)"
                                 class="sort-icon sorted-{{gradeGridColumnHeaderReborn.gradeGridRebornController.getSortTypeValue(columnMetadata.id)}} js-{{gradeGridColumnHeaderReborn.gradeGridRebornController.getSortTypeValue(columnMetadata.id)}}-icon">
        </bb-arrow-sort-indicator>
      </div>
    </div>
    <div>
      <span ng-if="columnMetadata.isFormative" class="formative-label"
          id="summary-formative-{{columnMetadata.id}}"
          aria-hidden="true"
          bb-translate>
          components.directives.grade.grid.formative
      </span>
    </div>
  </div>

  <div ng-if="gradeGridColumnHeaderReborn.col.data.summary.numStudentsSubmitted > 0">
    <anonymous-submission-bulk-download open="gradeGridColumnHeaderReborn.shouldShowAnonymousBulkDownloadModal"
                                        on-close-dialog="gradeGridColumnHeaderReborn.hideAnonymousDownloadModal"
                                        course-id="gradeGridColumnHeaderReborn.col.data.courseId"
                                        column-id="gradeGridColumnHeaderReborn.col.id"
                                        num-students-submitted="gradeGridColumnHeaderReborn.col.data.summary.numStudentsSubmitted"
    ></anonymous-submission-bulk-download>
  </div>
  <div ng-if="gradeGridColumnHeaderReborn.col.data.summary.numStudentsSubmitted === 0">
    <anonymous-no-submission-bulk-download open="gradeGridColumnHeaderReborn.shouldShowAnonymousBulkDownloadModal"
                                           on-close-dialog="gradeGridColumnHeaderReborn.hideAnonymousDownloadModal"
    ></anonymous-no-submission-bulk-download>
  </div>

  <div class="grade-grid-header-summary" tabindex="0"
    id="summary-points-{{columnMetadata.id}}">
    <span class="ellipse points" title="{{gradeGridColumnHeaderReborn.getSchemaText()}}">{{gradeGridColumnHeaderReborn.getSchemaText()}}</span>
  </div>
  <div ng-if="col.isShowSummary() && columnMetadata.isVisibleToStudents() && !columnMetadata.summary.isAllGradedAndPosted() && !columnMetadata.isCalculated()"
    class="grade-grid-header-summary"
    tabindex="0"
    id="summary-info-{{columnMetadata.id}}">
    <div ng-if="gradeGridColumnHeaderReborn.isRestricted()" >
      <span ng-if="columnMetadata.isFormative" class="sr-only"
            bb-translate-attrs="{'title': 'components.directives.grade.grid.formative'}"
            id="summary-formative-{{columnMetadata.id}}"
            bb-translate>
            components.directives.grade.grid.formative
      </span>
      <span ng-if="isGroupTest" class="sr-only" bb-translate>components.directives.grade.grader-column.statuses.restricted</span>
      <span class="sr-only">{{gradeGridColumnHeaderReborn.getSchemaText()}}</span>
      <bb-button-complex-tooltip></bb-button-complex-tooltip>
      <span class="ellipse grade-status" bb-translate>components.directives.grade.grader-column.statuses.restricted</span>
    </div>

    <div ng-if="!gradeGridColumnHeaderReborn.isRestricted()" class="grade-and-post" >
      <span ng-if="columnMetadata.isFormative" class="sr-only"
            bb-translate-attrs="{'title': 'components.directives.grade.grid.formative'}"
            id="summary-formative-{{columnMetadata.id}}"
            bb-translate>
            components.directives.grade.grid.formative
      </span>
      <span ng-if="isGroupTest" class="sr-only" bb-translate>components.directives.grade.grid.groupAriaLabel</span>
      <span class="sr-only">{{gradeGridColumnHeaderReborn.getSchemaText()}}</span>
      <span class="ellipse grade-count" ng-if="gradeGridColumnHeaderReborn.gradeGridRebornController.gridData.isSummaryLoaded && gradeGridColumnHeaderReborn.isScorable()"
            bb-translate-attrs="{'title': 'components.directives.grade.grid.gradedTip'}" translate-attrs-values="{count: gradeGridColumnHeaderReborn.getGradeCount()}"
            bb-translate translate-values="{count: gradeGridColumnHeaderReborn.getGradeCount()}">components.directives.grade.grid.graded</span>
      <span class="grade-pipe" ng-if="gradeGridColumnHeaderReborn.gradeGridRebornController.gridData.isSummaryLoaded && gradeGridColumnHeaderReborn.isScorable()"></span>
      <span class="ellipse grade-posted-count" ng-if="gradeGridColumnHeaderReborn.gradeGridRebornController.gridData.isSummaryLoaded && gradeGridColumnHeaderReborn.isScorable()"
            bb-translate-attrs="{'title': 'components.directives.grade.grid.postedTip'}" translate-attrs-values="{count: gradeGridColumnHeaderReborn.getPostedCount()}"
            bb-translate translate-values="{count: gradeGridColumnHeaderReborn.getPostedCount()}">components.directives.grade.grid.posted</span>
    </div>
  </div>

  <div ng-if="col.isShowSummary() && columnMetadata.isVisibleToStudents() && columnMetadata.summary.isAllGradedAndPosted() && !columnMetadata.isCalculated()"
       class="grade-grid-header-summary"
       ng-class="{'grade-complete-status': !gradeGridColumnHeaderReborn.isRestricted()}"
       tabindex="0"
       id="summary-info-{{columnMetadata.id}}">
    <div ng-if="gradeGridColumnHeaderReborn.isRestricted()" >
      <span ng-if="columnMetadata.isFormative" class="sr-only"
            bb-translate-attrs="{'title': 'components.directives.grade.grid.formative'}"
            id="summary-formative-{{columnMetadata.id}}"
            bb-translate>
            components.directives.grade.grid.formative
      </span>
      <span ng-if="isGroupTest" class="sr-only" bb-translate>components.directives.grade.grader-column.statuses.restricted</span>
      <span class="sr-only">{{gradeGridColumnHeaderReborn.getSchemaText()}}</span>
      <bb-button-complex-tooltip></bb-button-complex-tooltip>
      <span class="ellipse grade-status" bb-translate>components.directives.grade.grader-column.statuses.restricted</span>
    </div>

    <div ng-if="!gradeGridColumnHeaderReborn.isRestricted()" >
      <span ng-if="columnMetadata.isFormative" class="sr-only"
            bb-translate-attrs="{'title': 'components.directives.grade.grid.formative'}"
            id="summary-formative-{{columnMetadata.id}}"
            bb-translate>
            components.directives.grade.grid.formative
      </span>
      <span ng-if="isGroupTest" class="sr-only" bb-translate>components.directives.grade.grid.groupAriaLabel</span>
      <span class="sr-only">{{gradeGridColumnHeaderReborn.getSchemaText()}}</span>
      <bb-svg-icon size="small" icon="complete" status="success"></bb-svg-icon>
      <span class="ellipse grade-status" bb-translate>components.directives.grade.grid.completeLabel</span>
    </div>
  </div>

  <div ng-if="col.isShowSummary() && columnMetadata.isVisibleToStudents() && columnMetadata.summary.isAllGradedAndPosted() && !columnMetadata.isCalculated()" class="grade-grid-header-summary"
       tabindex="0"
       bb-translate-attrs="{'title': 'components.directives.grade.grader-column.statuses.restricted'}"
       id="summary-info-{{columnMetadata.id}}">
    <div ng-if="gradeGridColumnHeaderReborn.isRestricted()" >
      <span ng-if="columnMetadata.isFormative" class="sr-only"
            bb-translate-attrs="{'title': 'components.directives.grade.grid.formative'}"
            id="summary-formative-{{columnMetadata.id}}"
            bb-translate>
            components.directives.grade.grid.formative
      </span>
      <span ng-if="isGroupTest" class="sr-only" bb-translate>components.directives.grade.grader-column.statuses.restricted</span>
      <span class="sr-only">{{gradeGridColumnHeaderReborn.getSchemaText()}}</span>
      <bb-button-complex-tooltip></bb-button-complex-tooltip>
      <span class="ellipse grade-status" bb-translate>components.directives.grade.grader-column.statuses.restricted</span>
    </div>

    <div ng-if="!gradeGridColumnHeaderReborn.isRestricted()" >
      <span ng-if="columnMetadata.isFormative" class="sr-only"
            bb-translate-attrs="{'title': 'components.directives.grade.grid.formative'}"
            id="summary-formative-{{columnMetadata.id}}"
            bb-translate>
            components.directives.grade.grid.formative
      </span>
      <span ng-if="isGroupTest" class="sr-only" bb-translate>components.directives.grade.grid.groupAriaLabel</span>
      <span class="sr-only">{{gradeGridColumnHeaderReborn.getSchemaText()}}</span>
      <bb-svg-icon size="small" icon="complete" status="success"></bb-svg-icon>
      <span class="ellipse grade-status" bb-translate>components.directives.grade.grid.completeLabel</span>
    </div>
  </div>

  <div ng-if="col.isShowSummary() && columnMetadata.isVisibleToStudents() && columnMetadata.summary.isAllGradedAndPosted() && !columnMetadata.isCalculated()"
       class="grade-grid-header-summary"
       tabindex="0"
       bb-translate-attrs="{'title': 'components.directives.grade.grid.completeLabel'}"
       id="summary-info-{{columnMetadata.id}}">
    <div ng-if="gradeGridColumnHeaderReborn.isRestricted()" >
      <span ng-if="columnMetadata.isFormative" class="sr-only"
            bb-translate-attrs="{'title': 'components.directives.grade.grid.formative'}"
            id="summary-formative-{{columnMetadata.id}}"
            bb-translate>
            components.directives.grade.grid.formative
      </span>
      <span ng-if="isGroupTest" class="sr-only" bb-translate>components.directives.grade.grader-column.statuses.restricted</span>
      <span class="sr-only">{{gradeGridColumnHeaderReborn.getSchemaText()}}</span>
      <bb-button-complex-tooltip></bb-button-complex-tooltip>
      <span class="ellipse grade-status" bb-translate>components.directives.grade.grader-column.statuses.restricted</span>
    </div>

    <div ng-if="!gradeGridColumnHeaderReborn.isRestricted()" >
      <span ng-if="columnMetadata.isFormative" class="sr-only"
            bb-translate-attrs="{'title': 'components.directives.grade.grid.formative'}"
            id="summary-formative-{{columnMetadata.id}}"
            bb-translate>
            components.directives.grade.grid.formative
      </span>
      <span ng-if="isGroupTest" class="sr-only" bb-translate>components.directives.grade.grid.groupAriaLabel</span>
      <span class="sr-only">{{gradeGridColumnHeaderReborn.getSchemaText()}}</span>
      <bb-svg-icon size="small" icon="complete" status="success"></bb-svg-icon>
      <span class="ellipse grade-status" bb-translate>components.directives.grade.grid.completeLabel</span>
    </div>
  </div>

  <div ng-if="(!col.isShowSummary() || !columnMetadata.isVisibleToStudents()) && !columnMetadata.isCalculated()"
       class="grade-grid-header-summary"
       tabindex="0"
       id="summary-info-{{columnMetadata.id}}">
    <div ng-if="gradeGridColumnHeaderReborn.isRestricted()" >
      <span ng-if="columnMetadata.isFormative" class="sr-only"
            bb-translate-attrs="{'title': 'components.directives.grade.grid.formative'}"
            id="summary-formative-{{columnMetadata.id}}"
            bb-translate>
            components.directives.grade.grid.formative
      </span>
      <span ng-if="isGroupTest" class="sr-only" bb-translate>components.directives.grade.grader-column.statuses.restricted</span>
      <span class="sr-only">{{gradeGridColumnHeaderReborn.getSchemaText()}}</span>
      <bb-button-complex-tooltip></bb-button-complex-tooltip>
      <span class="ellipse grade-status" bb-translate>components.directives.grade.grader-column.statuses.restricted</span>
    </div>

    <div ng-if="!gradeGridColumnHeaderReborn.isRestricted()" >
      <span ng-if="columnMetadata.isFormative" class="sr-only"
            bb-translate-attrs="{'title': 'components.directives.grade.grid.formative'}"
            id="summary-formative-{{columnMetadata.id}}"
            bb-translate>
            components.directives.grade.grid.formative
      </span>
      <span ng-if="isGroupTest" class="sr-only" bb-translate>components.directives.grade.grid.groupAriaLabel</span>
      <span class="sr-only">{{gradeGridColumnHeaderReborn.getSchemaText()}}</span>
      <span class="ellipse grade-status"></span>
    </div>
  </div>

  <div ng-if="columnMetadata.isCalculated()"
       class="grade-grid-header-summary"
       tabindex="0"
       id="summary-info-{{columnMetadata.id}}">
    <div ng-if="gradeGridColumnHeaderReborn.isRestricted()" >
      <span ng-if="columnMetadata.isFormative" class="sr-only"
            bb-translate-attrs="{'title': 'components.directives.grade.grid.formative'}"
            id="summary-formative-{{columnMetadata.id}}"
            bb-translate>
            components.directives.grade.grid.formative
      </span>
      <span ng-if="isGroupTest" class="sr-only" bb-translate>components.directives.grade.grader-column.statuses.restricted</span>
      <span class="sr-only">{{gradeGridColumnHeaderReborn.getSchemaText()}}</span>
      <bb-button-complex-tooltip></bb-button-complex-tooltip>
      <span class="ellipse grade-status" bb-translate>components.directives.grade.grader-column.statuses.restricted</span>
    </div>

    <div ng-if="!gradeGridColumnHeaderReborn.isRestricted()" >
      <span ng-if="columnMetadata.isFormative" class="sr-only"
            bb-translate-attrs="{'title': 'components.directives.grade.grid.formative'}"
            id="summary-formative-{{columnMetadata.id}}"
            bb-translate>
            components.directives.grade.grid.formative
      </span>
      <span class="sr-only">{{gradeGridColumnHeaderReborn.getSchemaText()}}</span>
      <span class="ellipse items-count" ng-if="columnMetadata.itemsCount !== undefined"
        bb-translate-attrs="{'title': 'components.directives.grade.grid.itemsTip'}"
        translate-attrs-values="{count: columnMetadata.itemsCount}" bb-translate
        translate-values="{count: columnMetadata.itemsCount}">components.directives.grade.grid.items.plural</span>
    </div>
  </div>
</div>
