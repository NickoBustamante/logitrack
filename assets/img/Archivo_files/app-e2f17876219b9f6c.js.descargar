  <ul class="f-dropdown f-dropdown-overflow-menu reborn-dropdown" role="menu">

    <li role="presentation">
      <a role="menuitem"
         class="js-add-item"
         bb-peek-sref="grade-item.create({positionAfter: positionAfter})"
         analytics-id="components.directives.grade.grid.addItem">
        <bb-svg-icon size="small" icon="add"></bb-svg-icon>
        <bb-translate>components.directives.grade.grid.addItem</bb-translate>
      </a>
    </li>
    <!-- @TODO AB#2519887 remove this \`ng-if="isTextColumn"\` while removing the feature flag -->
    <li role="presentation" ng-if="isTextColumn">
      <a role="menuitem"
         bb-peek-sref="gradebook-item.text-column({positionAfter: positionAfter})"
         analytics-id="components.directives.grade.grid.addTextItem">
          <bb-ui-icon-small-notes></bb-ui-icon-small-notes>
         <bb-translate>components.directives.grade.grid.addTextItem</bb-translate>
      </a>
    </li>

    <li role="presentation">
      <a role="menuitem"
         class="js-add-calculation"
         bb-peek-sref="gradebook-item.calculation({positionAfter: positionAfter})"
         analytics-id="components.directives.grade.grid.addCalculation">
        <bb-svg-icon size="small" icon="calculation"></bb-svg-icon>
        <bb-translate>components.directives.grade.grid.addCalculation</bb-translate>
      </a>
    </li>

    <li role="presentation">
      <a role="menuitem"
         class="js-add-total-calculation"
         bb-peek-sref="gradebook-item.total-calculation({positionAfter: positionAfter, isExternalGrade: false})"
         analytics-id="components.directives.grade.grid.addTotalCalculation">
        <bb-svg-icon size="small" icon="calculation"></bb-svg-icon>
        <bb-translate>components.directives.grade.grid.addTotalCalculation</bb-translate>
      </a>
    </li>

    <li role="presentation" ng-if="!attendanceColumnExists && attendanceIsAvailable">
      <a role="menuitem"
         bb-peek-sref="attendance"
         analytics-id="components.directives.grade.grid.addAttendance">
        <bb-svg-icon size="small" icon="attendance" ></bb-svg-icon>
        <bb-translate>components.directives.grade.grid.addAttendance</bb-translate>
      </a>
    </li>
