          class="notification"
          modal-title-key="components.services.error-modal.error.title"
          analytics-id-tag-prefix="components.services.error-modal">
  <div name="modal-contents">
    <p bb-translate>components.services.error-modal.error.description</p>
    <pre>{{ response | json }}</pre>
    <bb-session-debug-modal-button></bb-session-debug-modal-button>
  </div>
  <button name="modal-footer-button-primary"
          ng-click="$parent.$dismiss()"
          class="button js-primary-button"
          analytics-id="components.services.error-modal.something-went-wrong.dismiss"
