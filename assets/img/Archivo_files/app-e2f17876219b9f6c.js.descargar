          modal-translate-options="modalTranslateOptions"
          modal-aria-type="alertdialog"
          analytics-id-tag-prefix="components.directives.pastDueZeroSettings">
  <div name="modal-contents">
    <!-- Instructions -->
    <p bb-translate>{{ modalTranslateOptions.instructions.key }}</p>
    <!-- Past due zero: Unassign zero -->
    <div ng-if="!pastDueZero.isPastZeroAssigned">
      <fieldset ng-if="modalTranslateOptions.choices && modalTranslateOptions.choices.length > 0"
                class="fieldset-options">
        <legend class="sr-only" bb-translate="{{ modalTranslateOptions.title.key }}"></legend>
        <div class="option-item" ng-repeat="option in modalTranslateOptions.choices">
          <input type="radio" 
                 name="{{ ::option.name }}" 
                 id="{{ ::option.id }}"
                 ng-model="modalTranslateOptions.choiceModal"
                 ng-value="option.value"
                 analytics-id="components.directives.grade.pastDueZero.option.input.radio">
          <label for="{{ ::option.id }}" bb-translate>{{ ::option.localizedKey }}</label>
          <p ng-if="!!option.descriptionKey"
             class="past-due-unassign-description"
             bb-translate>
            {{ ::option.descriptionKey }}
          </p>
        </div>
      </fieldset>
    </div>
  </div>
  <button name="modal-footer-button-primary" 
          type="button" 
          class="button confirm-ok js-primary-button" 
          ng-click="okAction()" 
          analytics-id="{{modalTranslateOptions.confirm.key}}"
          bb-translate>
    {{modalTranslateOptions.confirm.key}}
  </button>
  <button name="modal-footer-button-secondary" 
          type="button" 
          class="button button--secondary confirm-cancel js-secondary-button" 
          ng-click="cancelAction()" 
          analytics-id="{{modalTranslateOptions.cancel.key}}"
          bb-translate>
    {{modalTranslateOptions.cancel.key}}
  </button>
</bb-modal>`},846582(e,t,n){"use strict";n.d(t,{l:()=>a.l});var a=n(17003)},847025(e,t,n){"use strict";n.d(t,{Jk:()=>s,Ti:()=>r});var a=n(514041);let i=a.createContext({panelHeightOffset:0}),s=e=>{let t=t=>a.createElement(i.Consumer,null,n=>a.createElement(e,{...t,commonContext:n}));return t.displayName=`withAssessmentCommonContext(${e.displayName||e.name||"Component"})`,t},r=({usePanelHeightOffset:e,children:t})=>{let n=e();return a.createElement(i.Provider,{value:{panelHeightOffset:n}},t)}},850312(e,t,n){"use strict";n.d(t,{eG:()=>f});var a=n(172584),i=n(332831),s=n(707591),r=n(446079),o=n(79475),l=n(514041),d=n(899473),c=n(677004),u=n(843144),m=n(196142),p=n(953034),g=n(920782);class h extends l.Component{constructor(e){super(e),this.state={hasError:!1}}static getDerivedStateFromError(){return{hasError:!0}}componentDidCatch(e){console.error("ErrorBoundary caught exception",e),"u">typeof NREUM&&NREUM.noticeError(e),this.props.errorModalService.handleError({exception:e})}render(){return this.state.hasError?l.createElement("div"):this.props.children}}var b=n(933296);class v{$onChanges(e){let t=this.props,n=Object.fromEntries(Object.entries(e).map(e=>{let[t,n]=e;return[t,n.currentValue]})),a={...this.props,...n};if(this.isFirstRender){this.props=a,this.render(),this.isFirstRender=!1;return}this.didPropsChange(n,t)&&(this.props=a,this.render())}$onDestroy(){this.componentWillUnmount()}didPropsChange(e,t){return Object.entries(e).some(e=>{let[n,a]=e;return a!==t[n]})}componentWillUnmount(){}render(){}constructor(){this.isFirstRender=!0,this.props={}}}function f(e){let t={...e,attributes:e.attributes??[],bindingNames:e.bindingNames??Object.keys(e.Class.propTypes??{}),injectNames:e.injectNames??[],withErrorModalBoundary:e.withErrorModalBoundary??!0,withThemeProvider:e.withThemeProvider??!0},n=[],f=!!t.renderLocalized||t.withThemeProvider;return t.withErrorModalBoundary&&n.push(b.fe),f&&n.push(p.fe),(f||t.withTransitScope)&&n.push("$scope"),t.withProvider&&n.push("$ngRedu