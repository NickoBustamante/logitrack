  <!-- Display a loading spinner if page is rendering -->
  <div class="telemetry-loading-anim" ng-if="telemetryPanelHeader.showSpinner">
    <div class="spinner bb-secondary-color-2"/>
  </div>
  <header class="panel-header simple-header">
    <div class="panel-titles-container">
      <div class="panel-sub-title">{{ ::course().name }}</div>
      <div class="black-header-contents">
        <button class="menu-toggle standard-button dark-background"
                menu-toggle-click
                type="button"
                analytics-id="components.directives.telemetry.panel.menu.button">
          <bb-svg-icon size="small" icon="main-menu"></bb-svg-icon>
          <span class="sr-only" bb-translate>components.directives.telemetry.panel.menu</span>
        </button>
        <h1 class="panel-title" ng-if="::titleKey" bb-translate>{{::titleKey}}</h1>
        <h1 class="panel-title" ng-if="title">{{::title}}</h1>
        <!-- BUTTON 2 (displayed to the left of Button 1) -->
        <button ng-if="buttonTwoIcon" id="button-two"
                aria-haspopup="true"
                class="standard-button dark-background hide-for-large-up"
                bb-translate-attrs="{'aria-label': buttonTwoAriaLabel,'title': buttonTwoTitle}"
                ng-click="buttonTwoCallback()"
                ng-class="{ 'active': mobileStudentListVisible }"
                analytics-id="components.directives.telemetry.panel.buttonwTwo.button">
          <i class="{{ ::buttonTwoIcon }}"></i>
          <span class="sr-only" bb-translate>buttonTwoTitle</span>
        </button>
        <!-- BUTTON 1 (displayed on the far right) -->
        <button ng-if="buttonOneIcon"
                id="button-one"
                class="standard-button dark-background hide-for-large-up"
                bb-translate-attrs="{'aria-label': buttonOneAriaLabel,'title': buttonOneTitle}"
                ng-click="buttonOneCallback()"
                analytics-id="components.directives.telemetry.panel.buttonOne.button">
          <i class="{{ ::buttonOneIcon }}"></i>
          <span class="sr-only" bb-translate>buttonOneTitle</span>
        </button>
      </div>
    </div>
  </header>
</div>
