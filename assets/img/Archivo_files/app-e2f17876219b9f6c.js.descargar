          role="alertdialog" 
          bb-translate-attrs="{'aria-label': 'course.conditionalRelease.removeConditionalAvailability.title'}"
          modal-title-key="course.conditionalRelease.removeConditionalAvailability.title"
          analytics-id-tag-prefix="course.conditionalRelease.removeConditionalAvailability">
